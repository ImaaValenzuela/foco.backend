PORT=4000
DATABASE_URL="postgresql://postgres.[tu-proyecto]:[tu-contraseña]@aws-0-[region].pooler.supabase.com:5432/postgres"

# CORS: orígenes permitidos separados por coma (sin espacios). Dejar vacío permite todos.
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,https://tu-frontend.com"

# Auth
JWT_SECRET="tu_firma_jwt_secreta_super_segura"
JWT_EXPIRATION="15m"
JWT_REFRESH_SECRET="otra_firma_secreta_para_refresh"
JWT_REFRESH_EXPIRATION="7d"

# Stripe Sandbox
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Chatbot AI
AI_PROVIDER="openai"
OPENAI_API_KEY="sk-proj-..."
GEMINI_API_KEY="AIzaSy..."
