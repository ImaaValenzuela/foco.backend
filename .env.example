PORT=4000
NODE_ENV=development
HOST=0.0.0.0

SUPABASE_URL=https://[tu-proyecto].supabase.co
SUPABASE_ANON_KEY=tu-clave-anon

DATABASE_URL="postgresql://postgres.[tu-proyecto]:[tu-contraseña]@aws-0-[region].pooler.supabase.com:5432/postgres"

# CORS: orígenes web permitidos separados por coma. Las peticiones nativas
# de mobile normalmente no envían Origin y no necesitan registrarse aquí.
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:8081,https://tu-frontend.com"

# Auth
JWT_SECRET="tu_firma_jwt_secreta_super_segura"
JWT_EXPIRATION="15m"
JWT_REFRESH_SECRET="otra_firma_secreta_para_refresh"
JWT_REFRESH_EXPIRATION="7d"

# Stripe Sandbox
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Chatbot AI
AI_PROVIDER="openai"
OPENAI_API_KEY="sk-proj-..."
GEMINI_API_KEY="AIzaSy..."

# Google Cloud Platform (Google Calendar Integration)
# En Google Cloud Console (APIs & Services > Credentials), crea un ID de cliente OAuth 2.0 (Aplicación Web).
# URI de redirección autorizados: http://localhost:5173, https://[tu-proyecto].supabase.co/auth/v1/callback
# Nota de desarrollo: En el "Consent Screen" en modo 'Testing', agrega los correos de prueba como 'Test users'.
GOOGLE_CLIENT_ID="tu-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="tu-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:5173"
TOKEN_ENCRYPTION_KEY="foco_secret_encryption_key_for_tokens_32"
